{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "packages/web/out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/fiscal-years/*/transactions/new",
        "destination": "/fiscal-years/_/transactions/new/index.html"
      },
      {
        "source": "/fiscal-years/*/transactions/*/edit",
        "destination": "/fiscal-years/_/transactions/_/edit/index.html"
      },
      {
        "source": "/fiscal-years/*/transactions",
        "destination": "/fiscal-years/_/transactions/index.html"
      },
      {
        "source": "/fiscal-years/*/general-ledger",
        "destination": "/fiscal-years/_/general-ledger/index.html"
      },
      {
        "source": "/fiscal-years/*/trial-balance",
        "destination": "/fiscal-years/_/trial-balance/index.html"
      },
      {
        "source": "/fiscal-years/*/opening-balance",
        "destination": "/fiscal-years/_/opening-balance/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
