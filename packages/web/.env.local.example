# When true, connect to the Firebase Emulator Suite automatically, for local
# development and testing. Development and tests must never reach the production
# project.
NEXT_PUBLIC_USE_EMULATOR=true

# Use a `demo-` prefixed project ID with the emulators; such an ID structurally
# cannot resolve to a real project.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-account-ledgers
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-account-ledgers.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# Supporting document files live in Cloud Storage. Any bucket name works with the emulator;
# in production, the bucket Terraform creates (see `terraform output`).
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-account-ledgers.appspot.com
